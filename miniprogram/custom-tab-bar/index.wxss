.boss-tab__text {
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 500;
}

.boss-tab__plus {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1;
  background: linear-gradient(160deg, #3ad4c2 0%, #15c5b0 55%, #0fb09c 100%);
  box-shadow: 0 8rpx 20rpx rgba(21, 197, 176, 0.32);
  border: 3rpx solid rgba(255, 255, 255, 0.9);
}

/* —— 录入物品弹层 —— */
.entry-mask {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(20, 24, 32, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: auto;
}

.entry-sheet {
  width: 100%;
  max-height: 82vh;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: #fff;
  box-sizing: border-box;
  overflow-y: auto;
}

.entry-sheet__title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 28rpx;
}

.entry-tabs {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 6rpx;
  margin: 0 auto 28rpx;
  max-width: 480rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  box-sizing: border-box;
}

.entry-tabs__item {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
}

.entry-tabs__item.is-on {
  color: #fff;
  background: #15c5b0;
  box-shadow: 0 6rpx 16rpx rgba(21, 197, 176, 0.35);
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  min-height: 112rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}

.entry-item__icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(40, 60, 90, 0.12);
}

.entry-item__glyph {
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.entry-item__text {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  text-align: center;
}

