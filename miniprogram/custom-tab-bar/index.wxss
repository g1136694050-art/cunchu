.tabbar-root {
  position: relative;
  z-index: 999;
}

.boss-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 32rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

/* 挡住导航后方透出的列表内容 */
.boss-tabbar__backdrop {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background: linear-gradient(
    180deg,
    rgba(244, 246, 251, 0) 0%,
    rgba(244, 246, 251, 0.92) 28%,
    #f4f6fb 48%,
    #f4f6fb 100%
  );
  pointer-events: none;
}

.boss-tabbar__shell {
  position: relative;
  z-index: 1;
  pointer-events: auto;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  align-items: center;
  min-height: 88rpx;
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 10rpx 28rpx rgba(20, 30, 50, 0.1),
    0 2rpx 8rpx rgba(20, 30, 50, 0.04);
}

.boss-tabbar__bubble {
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  z-index: 0;
  width: calc((100% - 16rpx) / 5);
  height: calc(100% - 8rpx);
  pointer-events: none;
  will-change: transform;
  transition: transform 0.5s cubic-bezier(0.22, 1.55, 0.36, 1);
}

.boss-tabbar__bubble-inner {
  width: 86%;
  height: 100%;
  margin: 0 auto;
  border-radius: 999rpx;
  background: #eef0f3;
  transform-origin: center center;
}

.boss-tabbar__bubble.is-pop .boss-tabbar__bubble-inner {
  animation: water-bubble 0.5s cubic-bezier(0.22, 1.2, 0.36, 1);
}

@keyframes water-bubble {
  0% {
    transform: scale(1, 1);
    border-radius: 999rpx;
  }
  28% {
    transform: scale(1.12, 0.88);
    border-radius: 46% 54% 48% 52% / 58% 42% 58% 42%;
  }
  58% {
    transform: scale(0.94, 1.08);
    border-radius: 54% 46% 55% 45% / 44% 56% 44% 56%;
  }
  100% {
    transform: scale(1, 1);
    border-radius: 999rpx;
  }
}

.boss-tab {
  position: relative;
  z-index: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b9199;
}

.boss-tab__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  min-width: 72rpx;
  height: 72rpx;
  padding: 2rpx 6rpx;
}

.boss-tab.is-active {
  color: #15c5b0;
}

.boss-tab.is-active .boss-tab__text {
  font-weight: 600;
}

.boss-tab__icon {
