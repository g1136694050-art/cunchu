.detail-page {
  padding-top: 24rpx;
}

.hero {
  position: relative;
  margin: 0 32rpx 24rpx;
  border-radius: 32rpx;
  overflow: hidden;
  min-height: 280rpx;
  color: #fff;
}

.hero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.35;
}

.hero__content {
  position: relative;
  z-index: 1;
  padding: 40rpx;
}

.hero__name {
  font-size: 36rpx;
  font-weight: 600;
}

.hero__qty {
  margin-top: 36rpx;
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
}

.hero__unit {
  font-size: 32rpx;
  font-weight: 500;
  opacity: 0.9;
  margin-left: 8rpx;
}

.hero__actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.qty-btn {
  margin: 0 !important;
  border-radius: 999rpx !important;
  background: rgba(255, 255, 255, 0.9) !important;
  color: #333 !important;
}

.qty-btn.primary {
  background: #15c5b0 !important;
  color: #fff !important;
}

.logs-title {
  margin: 32rpx 32rpx 16rpx;
  font-weight: 600;
  font-size: 30rpx;
}
