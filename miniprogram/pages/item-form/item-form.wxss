.form-page {
  padding-bottom: 48rpx;
}

.cover-box {
  margin: 24rpx 32rpx;
  height: 240rpx;
  border-radius: 24rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  color: #969799;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  font-size: 28rpx;
}

.field--area {
  align-items: flex-start;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  min-height: 160rpx;
}

.field__textarea {
  flex: 1;
  min-height: 120rpx;
  font-size: 28rpx;
  line-height: 1.5;
}
