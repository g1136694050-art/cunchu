<view class="home-page">
  <view class="home-hero">
    <view class="home-user" bindtap="goProfile">
      <image class="home-user__avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view class="home-user__meta">
        <text class="home-user__name">{{displayName}}</text>
        <text class="home-user__arrow">›</text>
      </view>
    </view>
    <view class="home-search">
      <view class="home-search__icon home-search__icon--search"></view>
      <input
        class="home-search__input"
        placeholder="搜索物品"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeyword"
        bindconfirm="onSearch"
      />
      <text wx:if="{{keyword}}" class="home-search__clear" bindtap="onClear">×</text>
      <view class="home-search__icon home-search__icon--scan" catchtap="onScan"></view>
    </view>
  </view>

  <view wx:if="{{alertText}}" class="summary-bar" bindtap="goAlerts">⚠ {{alertText}}</view>

  <view wx:if="{{!items.length}}" class="empty">还没有物品，点中间 + 添加</view>

  <block wx:else>
    <view wx:if="{{featured.length}}" class="section">
      <view class="section-head">
        <text class="h2">精选存量</text>
        <text class="section-sub">按价格 / 数量优先</text>
      </view>
      <scroll-view class="feature-scroll" scroll-x enable-flex>
        <view
          wx:for="{{featured}}"
          wx:key="id"
          class="feature-card"
          style="background: {{item.coverUrl ? '#f4f4f4' : item.categoryColor}};"
          data-id="{{item.id}}"
          bindtap="openItem"
        >
          <image wx:if="{{item.coverUrl}}" class="feature-card__bg" src="{{item.coverUrl}}" mode="aspectFill" />
          <view class="feature-card__mask" />
          <view class="feature-card__top">
            <text class="tag-dark">{{item.categoryName}}</text>
            <view class="more-btn light-on-dark" catchtap="openMore" data-id="{{item.id}}">···</view>
          </view>
          <view class="feature-card__body">
            <view class="feature-card__name">{{item.name}}</view>
            <view class="feature-card__loc">📍 {{item.locationName || '未指定位置'}}</view>
            <view class="feature-card__foot">
              <text wx:if="{{item.priceText}}" class="price">¥{{item.priceText}}</text>
              <text wx:else class="price muted">暂无标价</text>
              <text class="qty-chip">存量 {{item.qtyText}}{{item.unit}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="h2">常用物品</text>
        <text class="link-more" bindtap="goAlerts">提醒中心 ›</text>
      </view>
      <view class="item-list">
        <view
          wx:for="{{items}}"
          wx:key="id"
          class="list-card"
          data-id="{{item.id}}"
          bindtap="openItem"
        >
          <view
            class="list-card__cover"
            style="background: {{item.coverUrl ? '#ddd' : item.categoryColor}};"
          >
            <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
            <text class="cover-tag">{{item.categoryName}}</text>
          </view>
          <view class="list-card__main">
            <view class="list-card__title-row">
              <text class="list-card__title">{{item.name}}</text>
              <view class="more-btn" catchtap="openMore" data-id="{{item.id}}">···</view>
            </view>
            <view class="tag-row">
              <view wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="outline-tag">{{tag}}</view>
            </view>
            <view class="list-card__foot">
              <text class="sold">存量 {{item.qtyText}}{{item.unit}}</text>
              <text wx:if="{{item.priceText}}" class="price">¥{{item.priceText}}</text>
              <text wx:else class="price muted">暂无标价</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{showActions}}" class="sheet-mask" bindtap="closeActions">
    <view class="sheet" catchtap="">
      <view class="sheet__item" data-action="plus" bindtap="onAction">增加 1</view>
      <view class="sheet__item" data-action="minus" bindtap="onAction">减少 1</view>
      <view class="sheet__item" data-action="detail" bindtap="onAction">查看详情</view>
      <view class="sheet__item" data-action="edit" bindtap="onAction">编辑</view>
      <view class="sheet__item danger" data-action="delete" bindtap="onAction">删除</view>
      <view class="sheet__cancel" bindtap="closeActions">取消</view>
    </view>
  </view>
</view>
