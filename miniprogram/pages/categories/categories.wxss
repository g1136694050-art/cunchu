.cat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.add-btn {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid #15c5b0;
  color: #15c5b0;
  font-size: 26rpx;
}

.cat-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  color: #333;
  font-size: 26rpx;
}

.cat-chip.active {
  background: rgba(47, 107, 255, 0.12);
  border-color: #2f6bff;
  color: #2f6bff;
  font-weight: 600;
}

.cat-chip .count {
  opacity: 0.65;
  font-size: 24rpx;
}

.cat-chip .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dialog-mask {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.dialog {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.dialog__title {
  text-align: center;
  padding: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.color-presets {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx 8rpx;
}

.color-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
}

.dialog__actions {
  display: flex;
  border-top: 1rpx solid #f0f1f5;
  margin-top: 16rpx;
}

.dialog__btn {
  flex: 1;
  text-align: center;
  padding: 28rpx;
  font-size: 32rpx;
  color: #666;
}

.dialog__btn.primary {
  color: #15c5b0;
  font-weight: 600;
  border-left: 1rpx solid #f0f1f5;
}
